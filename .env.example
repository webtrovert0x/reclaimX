# ==============================================================================
# ReclaimX Environment Configuration (.env.example)
# BOT Chain Smart Contract Recovery Platform
# ==============================================================================

# Reown Project ID (Private, server-side only)
REOWN_PROJECT_ID=

# BOT Chain Network Configuration (BOT Chain Mainnet)
NEXT_PUBLIC_CHAIN_ID=677
NEXT_PUBLIC_RPC_URL=https://rpc.botchain.ai
NEXT_PUBLIC_CHAIN_NAME="BOT Chain Mainnet"
NEXT_PUBLIC_NATIVE_CURRENCY_SYMBOL=BOT
NEXT_PUBLIC_EXPLORER_URL=https://scan.botchain.ai

# Public Explorer API (BOT Chain Mainnet / Blockscout - No API key required)
NEXT_PUBLIC_EXPLORER_API_URL=https://scan.botchain.ai/api

# Deployed ContractRecoveryHub Address
NEXT_PUBLIC_CONTRACT_RECOVERY_HUB_ADDRESS=0x7feDd4981CF2448366c3de1099B43823D4Deac13

# Deployment Private Key (DO NOT commit or expose to browser!)
DEPLOYER_PRIVATE_KEY=
