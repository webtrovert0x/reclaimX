# Deployed ContractRecoveryHub Address
NEXT_PUBLIC_CONTRACT_RECOVERY_HUB_ADDRESS=0x8baf11bb2f5c35d81fd21cd40eae0c205113cba1

# Deployment Private Key (DO NOT commit or expose to browser!)
DEPLOYER_PRIVATE_KEY=
