{
  "name": "reclaim-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test:sol": "forge test -vvv",
    "test:backend": "node --import tsx --test test/backend/backend.test.ts",
    "test": "npm run test:sol && npm run test:backend",
    "deploy:testnet": "forge script script/DeployHub.s.sol:DeployHubScript --rpc-url https://rpc.bohr.life --broadcast",
    "deploy:mainnet": "forge script script/DeployHub.s.sol:DeployHubScript --rpc-url https://rpc.botchain.ai --broadcast --with-gas-price 20gwei",
    "verify": "forge verify-contract 0x7feDd4981CF2448366c3de1099B43823D4Deac13 contracts/ContractRecoveryHub.sol:ContractRecoveryHub --verifier blockscout --verifier-url https://scan.botchain.ai/api --compiler-version v0.8.20+commit.a1b79de6 --constructor-args 00000000000000000000000055da37abbf8c9141ada4dd1c2ef7211c0483ec1600000000000000000000000000000000000000000000000000b1a2bc2ec50000"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "@reown/appkit": "^1.8.24",
    "@reown/appkit-adapter-wagmi": "^1.8.24",
    "@tanstack/react-query": "^5.104.5",
    "@x402/core": "^2.28.0",
    "@x402/evm": "^2.28.0",
    "@x402/svm": "^2.28.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "viem": "^2.57.11",
    "wagmi": "^3.7.9"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
